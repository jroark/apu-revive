SUBDESIGN s03_parallel
( a[7..0] : INPUT;
  y7, y9 : OUTPUT; )
BEGIN
	y7 = (a0 & a1 & !a2) # (a0 & a2 & !a3) # (a0 & a3 & !a4) # (a0 & a4 & !a5) # (a0 & a5 & !a6) # (a0 & a6 & !a7) # (a0 & a7 & !a1);
	y9 = (a0 & a1 & !a2) # (a0 & a2 & !a3) # (a0 & a3 & !a4) # (a0 & a4 & !a5) # (a0 & a5 & !a6) # (a0 & a6 & !a7) # (a0 & a7 & !a1) # (a1 & a2 & !a3) # (a1 & a3 & !a4);
END;
